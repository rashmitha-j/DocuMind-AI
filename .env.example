# Backend configuration. Copy to .env (repository root) and fill in real values.
# On Render, set these in the service's Environment settings instead.
# Placeholder values only - never commit real keys.

# Required: free Gemini API key from https://aistudio.google.com/
GOOGLE_API_KEY=your-google-ai-studio-api-key

# Database. Leave empty for local SQLite (backend/data/documind.db).
# In production use a free hosted PostgreSQL (e.g. Neon or Supabase), otherwise
# accounts and documents are lost whenever the Render instance restarts.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIMENSIONS=768
# CHUNK_SIZE=1024
# CHUNK_OVERLAP=150
# SIMILARITY_TOP_K=5
# MAX_FILE_SIZE_MB=10
# MAX_FILES_PER_UPLOAD=5
# MAX_PDF_PAGES=300
# MAX_DOCUMENTS_PER_USER=50
# SESSION_TTL_HOURS=24
# ALLOW_REGISTRATION=true
# TRUST_PROXY_HEADERS=true
# Rate limits as requests/seconds
# RATE_LIMIT_AUTH=10/60
# RATE_LIMIT_UPLOAD=10/3600
# RATE_LIMIT_CHAT=20/600
# RATE_LIMIT_REINDEX=10/3600
# Extra comma-separated CORS origins, e.g. a Vercel preview URL
# ALLOWED_ORIGINS=
